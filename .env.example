LEADPILOT_ENV=development
LEADPILOT_LOG_LEVEL=INFO
# Local development:
LEADPILOT_DATABASE_URL=sqlite:///./data/leadpilot.db
# Supabase PostgreSQL (copy from Dashboard → Connect; prefer the transaction
# pooler for deployed Streamlit apps without dependable IPv6 support):
# LEADPILOT_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_URL_ENCODED_DATABASE_PASSWORD@POOLER_HOST:6543/postgres
# Direct connection (often IPv6):
# LEADPILOT_DATABASE_URL=postgresql+psycopg://postgres:YOUR_URL_ENCODED_DATABASE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
LEADPILOT_DISCOVERY_CONNECT_TIMEOUT=5
LEADPILOT_DISCOVERY_READ_TIMEOUT=10
LEADPILOT_DISCOVERY_MAX_PAGES=9
LEADPILOT_DISCOVERY_MAX_RESPONSE_BYTES=2000000
LEADPILOT_DISCOVERY_USER_AGENT=LeadPilot/0.1 Website Discovery
LEADPILOT_DISCOVERY_RETRY_COUNT=1
LEADPILOT_DISCOVERY_SLOW_RESPONSE_MS=3000

# Optional AI Discovery Intelligence (disabled safely by default)
LEADPILOT_AI_ENABLED=false
LEADPILOT_AI_PROVIDER=openai
LEADPILOT_AI_MODEL=gpt-5-mini
LEADPILOT_AI_API_KEY=
LEADPILOT_AI_TIMEOUT_SECONDS=60
LEADPILOT_AI_MAX_RETRIES=1
LEADPILOT_AI_TEMPERATURE=0.2
LEADPILOT_AI_MAX_OUTPUT_TOKENS=6000
# Optional cost-estimation rates; leave blank when not explicitly configured.
LEADPILOT_AI_INPUT_PRICE_PER_MILLION=
LEADPILOT_AI_OUTPUT_PRICE_PER_MILLION=
LEADPILOT_APP_NAME=LeadPilot AI

# Supabase authentication (disabled until configured)
LEADPILOT_AUTH_ENABLED=false
LEADPILOT_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
LEADPILOT_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-only secret used for invitations/admin actions. Never expose to the browser.
LEADPILOT_SUPABASE_SERVICE_ROLE_KEY=
LEADPILOT_AUTH_REDIRECT_URL=
